name: Build Android APK
on:
  push:
    branches: [ main ]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      
      - name: HTML to APK Action
        uses: kimhuilim/html-to-apk-action@v1.0.0
        with:
          build-folder-path: './'
          app-name: 'SmartReceipts'
          output-folder-path: 'apk/'

      - name: Upload APK Artifact
        uses: actions/upload-artifact@v4
        with:
          name: SmartReceipts-APK
          path: apk/*.apk
